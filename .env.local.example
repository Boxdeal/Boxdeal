# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ─── Resend (Email) ──────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=orders@boxdeal.in
RESEND_FROM_NAME=BoxDeal

# ─── Shiprocket ──────────────────────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
# Origin/warehouse pincode — used to fetch live delivery rates (courier serviceability).
SHIPROCKET_PICKUP_PINCODE=your_pickup_pincode

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BoxDeal

# ─── Analytics ───────────────────────────────────────────────
# Meta (Facebook) Pixel ID — public value; code me fallback bhi hai.
NEXT_PUBLIC_META_PIXEL_ID=1034700985637340

# ─── Admin ───────────────────────────────────────────────────
ADMIN_SECRET_KEY=your_secure_admin_secret_key
